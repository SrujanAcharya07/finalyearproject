SECRET_KEY=replace-me
DATABASE_PATH=database/app.db
MAX_UPLOAD_BYTES=5242880

# Local Ollama analysis
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_NUM_PREDICT=800

# Protected login credentials. Configure these in the deployment secret store.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Alternatively use a werkzeug password hash instead of ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=
# Set false only for plain-http local development; keep true for HTTPS deployment.
SESSION_COOKIE_SECURE=false

CUCKOO_URL=
CUCKOO_API_KEY=
CORTEX_URL=
CORTEX_API_KEY=
THEHIVE_URL=
THEHIVE_API_KEY=
