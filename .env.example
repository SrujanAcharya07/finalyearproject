SECRET_KEY=replace-me
DATABASE_PATH=database/app.db
MAX_UPLOAD_BYTES=5242880

# Ollama local analysis
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_NUM_PREDICT=800

# Manus OAuth is injected by managed Preview and published deployment.
# For local OAuth testing, provide values from the managed project runtime.
MANUS_PROJECT_ID=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=
MANUS_JWT_SECRET=
# Set false only for plain-http local development; keep true in Preview/production.
SESSION_COOKIE_SECURE=false

CUCKOO_URL=
CUCKOO_API_KEY=
CORTEX_URL=
CORTEX_API_KEY=
THEHIVE_URL=
THEHIVE_API_KEY=
